# ===== WAJIB =====
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# ===== Cloudflare Turnstile =====
TURNSTILE_SECRET=your-turnstile-secret-key

# ===== SMTP (untuk fitur lupa kata sandi) =====
# Gunakan Brevo / Mailgun / Gmail App Password / dll
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Synpera" <noreply@yourdomain.com>

# URL publik aplikasi (untuk link reset kata sandi di email)
APP_URL=https://your-app.onrender.com

# ===== Opsional =====
PORT=3000
NODE_ENV=production
